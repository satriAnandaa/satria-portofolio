DATABASE_URL=postgresql://USER:PASSWORD@SUPABASE_POOLER_HOST:PORT/postgres?sslmode=verify-full&sslrootcert=supabase-ca.crt
PAYLOAD_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
NEXT_PUBLIC_SERVER_URL=https://YOUR_DOMAIN
DATABASE_PUSH=false
STORAGE_DRIVER=s3
S3_BUCKET=portfolio
S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=REGION_FROM_SUPABASE
S3_ACCESS_KEY_ID=SERVER_ONLY_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=SERVER_ONLY_S3_SECRET
# Optional password reset email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@YOUR_DOMAIN
