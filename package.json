{
  "name": "satria-data-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup:local": "node scripts/setup-local.mjs",
    "db:local": "node scripts/local-db.mjs",
    "seed": "tsx src/scripts/seed.ts",
    "admin:create": "tsx src/scripts/admin.ts create",
    "admin:reset": "tsx src/scripts/admin.ts reset",
    "payload": "node --import dotenv/config node_modules/payload/bin.js",
    "generate:types": "node --import dotenv/config node_modules/payload/bin.js generate:types",
    "generate:importmap": "node --import dotenv/config node_modules/payload/bin.js generate:importmap",
    "db:migrate": "node --import dotenv/config node_modules/payload/bin.js migrate",
    "db:migration": "node --import dotenv/config node_modules/payload/bin.js migrate:create",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test --test-force-exit tests/api.integration.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/storage-s3": "3.93.0",
    "@payloadcms/translations": "^3.93.0",
    "@tailwindcss/postcss": "4.3.5",
    "dotenv": "18.0.10",
    "graphql": "16.15.0",
    "next": "16.4.5",
    "payload": "3.93.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "node": "24.22.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
