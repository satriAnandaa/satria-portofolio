# Copy to .env. Never commit actual credentials.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5433/portfolio
PAYLOAD_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Development only: automatic schema synchronization; production uses migrations.
DATABASE_PUSH=false
# Local by default. Use s3 on Vercel; never rely on local uploads there.
STORAGE_DRIVER=local
S3_BUCKET=portfolio
S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=YOUR_SUPABASE_REGION
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional SMTP for password reset emails. Operator reset also available.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
